# Leave unset to run fully offline (default deterministic backends).
# Set to enable the production swaps:
# ANTHROPIC_API_KEY=sk-ant-...
# RAG_CONTEXTUALIZER=anthropic     # local (default) | anthropic
# RAG_GENERATOR=anthropic          # extractive (default) | anthropic
# RAG_ANTHROPIC_MODEL=claude-3-5-haiku-latest
# RAG_CORPUS_DIR=./corpus
