# CLEARANCE demo backend — deploy env SCHEMA (NO real values; copy to the PaaS secrets).
# The backend runs the SAFE synthetic profile: NO live LLM/DB/embedding credential here.
# (CLEARANCE_API_URL is the FE's var, set in Vercel — NOT here.)

# --- Gate B: the safe profile (enforced; assert_synthetic_only refuses to start otherwise) ---
RAG_DEMO_PROFILE=synthetic          # MUST be 'synthetic' for the public demo
RAG_STORE_BACKEND=memory            # in-memory; do NOT point at a live SurrealDB Cloud DSN
RAG_CORPUS_DIR=/app/corpus          # baked into the image

# --- Gate B: abuse caps (per-key + instance-wide) ---
RAG_RATE_LIMIT_PER_MIN=30
RAG_INSTANCE_RATE_LIMIT_PER_MIN=1500
RAG_QUERY_CAP_PER_DAY=500

# --- runtime ---
PORT=8000                           # the PaaS sets this; uvicorn binds it

# --- DELIBERATELY ABSENT (would make assert_synthetic_only refuse to start) ---
# GROQ_API_KEY / RAG_SQL_LLM_API_KEY / VOYAGE_API_KEY / ANTHROPIC_API_KEY
# SURREAL_DSN (live cloud) — the synthetic demo uses none of these.
